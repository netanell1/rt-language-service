{
    "scopeName": "source.template-rt-component",
    "patterns": [
        {
            "begin": "_\\{",
            "end": "\\}_",
            "name": "meta.template",
            "patterns": [
                {
                    "match": "\\b(functionName|componentName|styleFileName)\\b",
                    "name": "variable.name"
                },
                {
                    "match": "\\b[a-zA-Z_]+\\b",
                    "name": "invalid.illegal"
                }
            ]
        },
        {
            "include": "source.tsx"
        },
        {
            "include": "source.js"
        }
    ],
    "fileTypes": [
        "component-rt.template"
    ],
    "firstLineMatch": "^//\\s*template-rt-component"
}